# Copy to .env and fill in. Avoid URL-special characters (@ : / ? #) in passwords.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loopiq
AIRFLOW_DB=airflow

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me
# Generate with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# Linux: set to the output of `id -u` so Airflow can write logs/ and reports/.
AIRFLOW_UID=50000
